{
  "name": "mace-man-3dbuilder",
  "private": true,
  "version": "1.1.3",
  "description": "mace-man 3D Builder - Local 3D Model Editor and Boolean Operations Tool",
  "author": "mace-man",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:start": "electron .",
    "electron:dev": "concurrently -k -s first \"npm run dev\" \"wait-on tcp:3000 && cross-env VITE_DEV_SERVER_URL=http://localhost:3000 electron .\"",
    "build:electron": "npm run build && electron-builder --publish never",
    "build:win": "npm run build && electron-builder --win --publish never",
    "build:mac": "npm run build && electron-builder --mac --publish never",
    "build:linux": "npm run build && electron-builder --linux --publish never",
    "build:linux:zip": "npm run build && electron-builder --linux zip --publish never",
    "build:all": "npm run build && electron-builder -wml --publish never"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "three": "^0.160.0",
    "three-bvh-csg": "^0.0.16"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "vite": "^5.0.12",
    "wait-on": "^9.1.0"
  }
}
